# Office Space. Copy what you need into the environment of the process that runs agent-office.
# Upstream Agent Office settings (password, city, budget, …) stay as in docs/configuration.md.

# Where Troy (GrokBot) receives OFFICE_NOTE requests.
# Leave unset to queue notes in <office home>/.office-space/notes.jsonl and show them on Troy's board.
# This process never calls Notion. Do not put a Notion URL here.
GROKBOT_WEBHOOK_URL=

# Optional sender key for that POST, sent as Authorization: Bearer <key>.
# GROKBOT_WEBHOOK_SECRET wins when both are set. Leave unset to send the JSON body only.
GROKBOT_WEBHOOK_SECRET=
GROKBOT_WEBHOOK_TOKEN=
